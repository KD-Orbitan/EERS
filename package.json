{
  "name": "eers",
  "version": "1.0.0",
  "description": "Enterprise Evaluation & Ranking System",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "portfolio:check": "pnpm --filter web exec tsc --noEmit && pnpm --filter api build && pnpm --filter api exec jest --runInBand && pnpm --filter api test:e2e --runInBand",
    "portfolio:infra": "docker compose -f docker-compose.portfolio.yml up -d --wait",
    "portfolio:migrate": "pnpm --filter api portfolio:migrate",
    "portfolio:seed": "pnpm --filter api portfolio:seed",
    "portfolio:dev": "pnpm --parallel --filter api --filter web portfolio:dev"
  },
  "devDependencies": {
    "turbo": "^1.10.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
